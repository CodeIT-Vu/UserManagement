<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*UserManagement.Web.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Include>
        <Source>.*[\\/]Services[\\/]UserService\.cs$</Source>
      </Include>
    </Sources>
  </CodeCoverage>
</Configuration>
