@model UserManagement.Web.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
}

<h1>Đăng nhập</h1>
@if (Request.QueryString["registered"] == "True" || Request.QueryString["registered"] == "true")
{
    <div class="alert alert-success" role="status">Đăng ký thành công. Vui lòng đăng nhập.</div>
}
@if (Request.QueryString["passwordChanged"] == "True" || Request.QueryString["passwordChanged"] == "true")
{
    <div class="alert alert-success" role="status">Đổi mật khẩu thành công. Vui lòng đăng nhập lại.</div>
}
<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ReturnUrl)

            <div class="alert alert-danger d-none" data-form-error role="alert"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.Username)
                @Html.TextBoxFor(model => model.Username, new { @class = "form-control", autocomplete = "username" })
                @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Password)
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
            <button class="btn btn-primary" type="submit">Đăng nhập</button>
            <a class="btn btn-link" href="@Url.Action("Register", "Account")">Đăng ký tài khoản</a>
        }
    </div>
</div>
