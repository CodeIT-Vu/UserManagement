@using UserManagement.Web.Constants
@model UserManagement.Web.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<h1>Đăng ký tài khoản</h1>
<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "registerForm" }))
        {
            @Html.AntiForgeryToken()
            <div class="alert alert-danger d-none" data-form-error role="alert"></div>
            <div class="form-group">
                @Html.LabelFor(model => model.Username)
                @Html.TextBoxFor(model => model.Username, new { @class = "form-control", autocomplete = "username", maxlength = UserValidationLimits.UsernameMaxLength })
                @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.FullName)
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", autocomplete = "name", maxlength = UserValidationLimits.FullNameMaxLength })
                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Email)
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", autocomplete = "email", type = "email", maxlength = UserValidationLimits.EmailMaxLength })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Password)
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "new-password", maxlength = UserValidationLimits.PasswordMaxLength })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ConfirmPassword)
                @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", maxlength = UserValidationLimits.PasswordMaxLength })
                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
            <p class="text-muted">Mật khẩu từ 8 đến 100 ký tự.</p>
            <button class="btn btn-primary" type="submit">Đăng ký</button>
            <a class="btn btn-link" href="@Url.Action("Login", "Account")">Quay lại</a>
        }
    </div>
</div>
