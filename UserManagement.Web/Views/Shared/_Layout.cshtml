@using UserManagement.Web.Models
@{
    AppUser currentUser = Context.Items["CurrentUser"] as AppUser;
    string loginUrl = Url.Action("Login", "Account");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - User Management</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
</head>
<body data-login-url="@loginUrl">
    <nav class="navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">User Management</a>
        @if (currentUser != null)
        {
            if (User.IsInRole("Admin"))
            {
                <a class="nav-link text-light" href="@Url.Action("Index", "Users")">Quản lý người dùng</a>
            }
            <a class="nav-link text-light" href="@Url.Action("ChangePassword", "Account")">Đổi mật khẩu</a>
            <span class="navbar-text ml-auto mr-3">@currentUser.FullName</span>
            using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", @class = "form-inline" }))
            {
                @Html.AntiForgeryToken()
                <div class="text-danger mr-2 d-none" data-form-error role="alert"></div>
                <button type="submit" class="btn btn-outline-light btn-sm">Đăng xuất</button>
            }
        }
    </nav>
    <main class="container py-4">@RenderBody()</main>
    <script src="@Url.Content("~/Scripts/jquery-3.5.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/popper.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script type="module" src="@Url.Content("~/Scripts/site.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
