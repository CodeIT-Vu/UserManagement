@model UserManagement.Web.ViewModels.UserSearchViewModel

@using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "card card-body mb-4" }))
{
    <div class="form-row">
        <div class="form-group col-md-4">
            @Html.LabelFor(model => model.Username)
            @Html.TextBoxFor(model => model.Username, new { @class = "form-control", maxlength = 50 })
            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
        </div>
        <div class="form-group col-md-4">
            @Html.LabelFor(model => model.FullName)
            @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", maxlength = 150 })
            @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
        </div>
        <div class="form-group col-md-4">
            @Html.LabelFor(model => model.IsActive)
            @Html.DropDownListFor(model => model.IsActive, new[]
            {
                new SelectListItem { Text = "Đang hoạt động", Value = "true" },
                new SelectListItem { Text = "Ngừng hoạt động", Value = "false" }
            }, "Tất cả", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
        </div>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Users")">Xoá bộ lọc</a>
    </div>
}
